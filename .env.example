# --- Redis (estado de los trabajos, cola y checkpoints de LangGraph) ---
REDIS_URL=redis://localhost:6379
# "redis" (default, produccion) o "memory" (solo para probar sin Redis Stack; el estado del grafo NO persiste)
CHECKPOINTER=redis

# --- LLM del orquestador ---
# "ollama" (default, gratis y local), "anthropic" u "openai"
GENERATION_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# Solo si GENERATION_PROVIDER=openai
OPENAI_API_KEY=sk-tu-api-key-de-openai-aca
OPENAI_MODEL=gpt-4o-mini

# Solo si GENERATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=tu-api-key-de-anthropic-aca
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Workers ---
# Cuantas tareas se procesan en paralelo (5 = las 5 peticiones concurrentes de la prueba de carga)
WORKER_CONCURRENCY=5
RECURSION_LIMIT=25
MAX_PASOS_SUPERVISOR=6
JOB_TTL_SECONDS=86400

# --- Observabilidad (Arize Phoenix) ---
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=orquestador-multiagente
